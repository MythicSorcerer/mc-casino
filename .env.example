# Copy to .env for local overrides. Never commit real credentials.

# Port the local demo API listens on (loopback only). Default: 3000
PORT=3000

# SQLite database path. Default: web/data/demo.sqlite
DATABASE_PATH=web/data/demo.sqlite

# Optional: require this token in the x-admin-token header for lottery draws.
# Leave unset for the single-account local demo.
ADMIN_TOKEN=

# Not yet wired — reserved for the future Minecraft payment bridge:
# MINECRAFT_SERVER_HOST=
# MINECRAFT_SERVER_PORT=25565
